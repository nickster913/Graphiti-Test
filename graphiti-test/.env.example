# Anthropic — required for extraction, synthesis, and eval judges
ANTHROPIC_API_KEY=sk-ant-...

# Optional model overrides (see scripts/anthropic_chat.py)
# ANTHROPIC_EXTRACT_MODEL=claude-sonnet-5
# ANTHROPIC_SYNTHESIS_MODEL=claude-sonnet-5
# ANTHROPIC_CYPHER_MODEL=claude-haiku-4-5
# ANTHROPIC_EVAL_MODEL=claude-haiku-4-5

# Langfuse — local instance (docker compose -f docker-compose.langfuse.yml up -d)
# These are the headless-init keys created on first boot, not Langfuse Cloud.
# UI: http://localhost:3100  login: local@graphiti-test.dev / langfuse-local
LANGFUSE_PUBLIC_KEY=pk-lf-local-graphiti-test
LANGFUSE_SECRET_KEY=sk-lf-local-graphiti-test
LANGFUSE_BASE_URL=http://localhost:3100
