{
  "schema_version": 1,
  "diagram_type": "dataflow",
  "meta": {
    "title": "graphiti-test Knowledge Graph + RAG Pipeline",
    "output": "docs/architecture.html",
    "viewBox": [1080, 780],
    "quality_profile": "showcase"
  },
  "stages": [
    { "label": "Sources" },
    { "label": "Extract (Claude)" },
    { "label": "Graph Seeds" },
    { "label": "Neo4j + Vectors" },
    { "label": "Consume (RAG)" }
  ],
  "nodes": [
    { "id": "transcripts", "type": "external", "label": "Reading Transcripts", "sublabel": ".txt session exports", "stage": 0, "row": 0, "tag": "raw" },
    { "id": "training", "type": "external", "label": "Agent Training Doc", "sublabel": "The2644 v1", "stage": 0, "row": 4, "tag": "raw" },
    { "id": "chunk", "type": "backend", "label": "chunk_transcript.py", "sublabel": "~3000-char chunks", "stage": 1, "row": 0, "width": 176 },
    { "id": "extract", "type": "backend", "label": "extract_nodes.py", "sublabel": "per-chunk entities", "stage": 1, "row": 1, "width": 160 },
    { "id": "claude", "type": "cloud", "label": "Claude API", "sublabel": "claude-sonnet-5", "stage": 1, "row": 2, "tag": "LLM", "width": 150 },
    { "id": "train_extract", "type": "backend", "label": "extract_training_doc.py", "sublabel": "per-section entities", "stage": 1, "row": 4, "width": 178 },
    { "id": "hd_seed", "type": "database", "label": "hd_graph_seed.json", "sublabel": "804 nodes / 888 edges", "stage": 2, "row": 1, "tag": "seed", "width": 176 },
    { "id": "train_seed", "type": "database", "label": "training_graph_seed.json", "sublabel": "172 nodes / 119 edges", "stage": 2, "row": 4, "tag": "seed", "width": 178 },
    { "id": "load", "type": "backend", "label": "load_graph.py", "sublabel": "direct Cypher MERGE", "stage": 3, "row": 2, "width": 160 },
    { "id": "neo4j", "type": "database", "label": "Neo4j", "sublabel": "graph + vector index", "stage": 3, "row": 3, "tag": "graph", "width": 150 },
    { "id": "embed", "type": "backend", "label": "embed_graph.py", "sublabel": "writes embeddings", "stage": 3, "row": 4, "width": 160 },
    { "id": "reader", "type": "backend", "label": "reader.py", "sublabel": "hybrid RAG: vector + graph", "stage": 4, "row": 2, "width": 190 },
    { "id": "ollama", "type": "cloud", "label": "Ollama", "sublabel": "nomic-embed-text 768-d", "stage": 4, "row": 4, "tag": "embeddings", "width": 176 }
  ],
  "flows": [
    { "id": "src-chunk", "from": "transcripts", "to": "chunk", "label": "session turns", "classification": "raw text", "labelDy": 53 },
    { "id": "chunk-extract", "from": "chunk", "to": "extract", "label": "transcript_chunks.json", "classification": "chunks", "labelDy": 24 },
    { "id": "extract-claude", "from": "extract", "to": "claude", "label": "chunk text", "classification": "prompt", "labelDy": 24 },
    { "id": "train-extract-claude", "from": "train_extract", "to": "claude", "label": "section text", "classification": "prompt", "labelAt": [315, 500] },
    { "id": "extract-hdseed", "from": "extract", "to": "hd_seed", "label": "hd_graph_seed.json", "classification": "merged graph", "variant": "emphasis", "labelDy": 53 },
    { "id": "train-src", "from": "training", "to": "train_extract", "label": "doc sections", "classification": "raw text", "labelDy": 53 },
    { "id": "train-trainseed", "from": "train_extract", "to": "train_seed", "label": "training_graph_seed.json", "classification": "merged graph", "labelDy": 53 },
    { "id": "hdseed-load", "from": "hd_seed", "to": "load", "label": "seed nodes/edges", "classification": "read" },
    { "id": "trainseed-load", "from": "train_seed", "to": "load", "label": "seed nodes/edges", "classification": "read", "labelAt": [642, 542] },
    { "id": "load-neo4j", "from": "load", "to": "neo4j", "label": "MERGE nodes/edges", "classification": "write", "variant": "emphasis", "labelDy": 24 },
    { "id": "neo4j-embed", "from": "neo4j", "to": "embed", "label": "insight / phrase text", "classification": "read", "labelDy": 24 },
    { "id": "embed-ollama", "from": "embed", "to": "ollama", "label": "text to embed", "classification": "embed call", "labelDy": 53 },
    { "id": "neo4j-reader", "from": "neo4j", "to": "reader", "label": "vector + graph context", "classification": "hybrid retrieval", "variant": "emphasis", "labelAt": [852, 428] },
    { "id": "reader-ollama", "from": "reader", "to": "ollama", "label": "question embedding", "classification": "embed call", "labelAt": [960, 500] }
  ],
  "cards": [
    {
      "dot": "emerald",
      "title": "Build: transcripts to graph",
      "items": [
        "chunk_transcript.py + extract_nodes.py / extract_training_doc.py call Claude (claude-sonnet-5) to extract HD entities",
        "Merged seeds (hd_graph_seed.json, training_graph_seed.json) are MERGEd into Neo4j by load_graph.py",
        "cleanup_centers.py optionally dedupes HDCenter nodes after loading"
      ]
    },
    {
      "dot": "violet",
      "title": "RAG layer (new)",
      "items": [
        "embed_graph.py embeds RayJaiTeaching.insight + HDVoicePattern.phrase via Ollama nomic-embed-text and builds Neo4j vector indexes",
        "reader.py embeds the question, vector-searches teachings (anchor), expands via the graph, and pulls verbatim voice exemplars",
        "Claude (claude-sonnet-5) synthesises the answer in RayJai's voice; retrieval falls back to keyword search if embeddings are absent"
      ]
    },
    {
      "dot": "amber",
      "title": "Notes",
      "items": [
        "Neo4j Browser (localhost:7474) is available for visual exploration",
        "analyze_voice.py computes RayJai word/phrase frequency straight from transcripts (standalone)",
        "Fine-tuning on RayJai's turns is the optional last-mile for deeper voice fidelity"
      ]
    }
  ]
}
